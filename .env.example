# EmployeeAI backend env
# Copy to `.env` and fill real values. Never commit `.env`.

# Neon Postgres (server-only)
DATABASE_URL=

# Auth - JWT session cookie signing (required for login)
AUTH_SECRET=

# API server port (default 3001; Render sets PORT automatically)
# PORT=3001

# Frontend origin for CORS (Vercel URL). Cookie itself defaults to SameSite=Lax
# so it works with the Vercel `/api` → Render rewrite (same browser origin).
FRONTEND_URL=https://employeeai-blue.vercel.app
# Only set this if the browser calls Render cross-origin (no Vercel proxy):
# COOKIE_SAMESITE=none

# AI / LangChain (server-only) - default provider: gemini
# Add YOUR OWN keys below (or leave blank and save keys in Settings → AI models).
# Gemini: https://aistudio.google.com/apikey
# OpenAI: https://platform.openai.com/api-keys
AI_PROVIDER=gemini
AI_MODEL_NAME=gemini-3.5-flash-lite
GOOGLE_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
