# EmployeeAI backend env
# Copy to `.env` and fill real values. Never commit `.env`.

# Neon Postgres (server-only)
DATABASE_URL=

# Auth - JWT session cookie signing (required for login)
AUTH_SECRET=

# API server port (default 3001; Render sets PORT automatically)
# PORT=3001

# Frontend origin for CORS + cookies (Vercel)
FRONTEND_URL=https://employeeai-blue.vercel.app

# AI / LangChain (server-only) - default provider: gemini
AI_PROVIDER=gemini
AI_MODEL_NAME=gemini-3.5-flash-lite
GOOGLE_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
